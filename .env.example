# Infraestructura del servicio
DATABASE_URL=
ENVIRONMENT=development
PORT=5000

# URL publica del backend central Agiliza360
SSGG_BASE_URL=http://localhost:3000

# Unico secreto compartido entre SSGG y el tracker. Las claves de pairing,
